{
  "id": "uzGojsdcqglRhVr1",
  "name": "Container Sync Schedules",
  "description": "Garmin and Strava run every hour, Hevy every 6 hours, hevy2garmin every 30 min. hevy2garmin -> Strava FIT Replace runs in sequence after hevy2garmin.",
  "connections": {
    "Garmin Every Hour": ["Run Garmin Sync"],
    "Run Garmin Sync": ["Check Garmin Exit"],
    "Check Garmin Exit": ["Alert Garmin Failed"],
    "Strava Every Hour": ["Run Strava Sync"],
    "Run Strava Sync": ["Check Strava Exit"],
    "Check Strava Exit": ["Alert Strava Failed"],
    "Hevy Every 6 Hours": ["Run Hevy Sync"],
    "Run Hevy Sync": ["Check Hevy Exit"],
    "Check Hevy Exit": ["Alert Hevy Failed"],
    "Hevy2garmin Every 30 minutes": ["Run hevy2garmin"],
    "Run hevy2garmin": ["Run Strava FIT Replace", "Check hevy2garmin exit"],
    "Run Strava FIT Replace": ["Check FIT Replace Exit"],
    "Check FIT Replace Exit": ["Alert FIT Replace Failed"],
    "Check hevy2garmin exit": ["Alert Hevy2Garmin Failed"]
  },
  "nodes": [
    { "name": "Run Garmin Sync", "command": "docker exec garmin-sync python garmin_sync.py" },
    { "name": "Run Strava Sync", "command": "docker exec strava-sync python strava_sync.py" },
    { "name": "Run Hevy Sync", "command": "docker exec hevy-sync python hevy_sync.py" },
    { "name": "Run hevy2garmin", "command": "docker exec hevy2garmin hevy2garmin sync" },
    { "name": "Run Strava FIT Replace", "command": "docker exec strava-sync python strava_replace_activity.py" }
  ]
}
