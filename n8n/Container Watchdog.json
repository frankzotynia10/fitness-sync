{
  "name": "Container Watchdog",
  "nodes": [
    {
      "parameters": {
        "content": "## Container Watchdog\nRuns every hour. Checks all 8 containers.\nIf any are down: restarts them, waits 30s, rechecks.\nOnly alerts if still down after restart attempt.\n\nCredentials: \"Andromeda SSH\" and \"ntfy\".",
        "height": 200,
        "width": 300,
        "color": 4
      },
      "id": "77a06bfc-d7d3-43ee-912b-a1c12e98d272",
      "name": "Sticky Note a0678969",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -16,
        -192
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours"
            }
          ]
        }
      },
      "id": "b0748807-2748-480f-ad58-32d452ab5116",
      "name": "Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        144
      ]
    },
    {
      "parameters": {
        "command": "docker inspect --format=\"{{.Name}}:{{.State.Running}}\" garmin-sync hevy-sync strava-sync claude-mcp hevy2garmin supabase-db supabase-rest supabase-meta supabase-studio 2>&1"
      },
      "id": "66d3452a-175e-4f8c-84bc-5ba45b97a41e",
      "name": "Check Containers",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        224,
        144
      ],
      "credentials": {
        "sshPassword": {
          "id": "qfnxXDv3iSEWihed",
          "name": "Andromeda SSH Root"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const stdout = $(\"Check Containers\").first().json.stdout || \"\";\nconst lines = stdout.trim().split(\"\\n\");\nvar down = [];\nlines.forEach(function(line) {\n  var parts = line.split(\":\");\n  var name = parts[0].replace(\"/\",\"\");\n  var running = parts[1];\n  if (running !== \"true\") { down.push(name); }\n});\nreturn [{ json: { down: down, hasDown: down.length > 0, restartCmd: down.length > 0 ? \"docker restart \" + down.join(\" \") : \"\" } }];"
      },
      "id": "e77c4a32-7a7e-4894-a341-24055e150e19",
      "name": "Parse Container Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        144
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.hasDown }}",
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "ce7ad3a8-52cb-427c-a278-a3d0127b68f8",
      "name": "Any Containers Down?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        672,
        144
      ]
    },
    {
      "parameters": {
        "command": "={{ $json.restartCmd }}"
      },
      "id": "11e10061-5a65-41c4-b050-3062b6babbbf",
      "name": "Restart Down Containers",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        896,
        64
      ],
      "credentials": {
        "sshPassword": {
          "id": "qfnxXDv3iSEWihed",
