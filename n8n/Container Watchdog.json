    {
      "parameters": {
        "command": "docker inspect --format=\"{{.Name}}:{{.State.Running}}\" garmin-sync hevy-sync strava-sync claude-mcp hevy2garmin supabase-db supabase-rest supabase-meta supabase-studio 2>&1"
      },
      "id": "555a1342-0c27-4634-884b-062441487475",
      "name": "Recheck Containers",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        1344,
        64
      ],
      "credentials": {
        "sshPassword": {
          "id": "qfnxXDv3iSEWihed",
          "name": "Andromeda SSH Root"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const stdout = $(\"Recheck Containers\").first().json.stdout || \"\";\nconst lines = stdout.trim().split(\"\\n\");\nvar stillDown = [];\nlines.forEach(function(line) {\n  var parts = line.split(\":\");\n  var name = parts[0].replace(\"/\",\"\");\n  var running = parts[1];\n  if (running !== \"true\") { stillDown.push(name); }\n});\nconst allRecovered = stillDown.length === 0;\nreturn [{ json: { stillDown: stillDown, allRecovered: allRecovered, summary: allRecovered ? \"All containers recovered after restart\" : \"STILL DOWN after restart: \" + stillDown.join(\", \") } }];"
      },
      "id": "697b8a28-9cd7-4684-b498-0031d795b3d4",
      "name": "Parse Recheck Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        64
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.allRecovered }}",
              "operator": {
                "type": "boolean",
                "operation": "false"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d5f8e6df-fe58-463e-aeaf-12ed127778ca",
      "name": "Still Down After Restart?",
