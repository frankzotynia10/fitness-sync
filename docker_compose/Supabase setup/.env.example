# -----------------------------
# Core Postgres config
# -----------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=postgres

# -----------------------------
# Postgres Meta (Supabase Studio backend)
# -----------------------------
PG_META_DB_HOST=db
PG_META_DB_PORT=5432
PG_META_DB_NAME=postgres
PG_META_DB_USER=postgres
PG_META_DB_PASSWORD=your_secure_password_here

# -----------------------------
# PostgREST (REST API layer)
# -----------------------------
PGRST_DB_URI=postgres://postgres:your_secure_password_here@db:5432/postgres
PGRST_DB_ANON_ROLE=postgres
PGRST_DB_SCHEMAS=public

# -----------------------------
# Supabase Studio config
# -----------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER_READ_WRITE=postgres

HOSTNAME=0.0.0.0
STUDIO_PG_META_URL=http://meta:8080

# -----------------------------
# Snippets (optional Studio feature)
# -----------------------------
SNIPPETS_MANAGEMENT_FOLDER=/app/snippets
